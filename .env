# Single env file for apps/shell, apps/app-hub, apps/cad (each vite.config.ts points envDir here)

# NFR-05: every origin comes from env and is injected into the MF config — no hardcoded URLs in source
VITE_SHELL_URL=http://localhost:5170
VITE_APP_HUB_URL=http://localhost:5174
VITE_CAD_URL=http://localhost:5175

# FR-12 / NFR-10: diagnostics in both dev and build/preview
VITE_MF_DEBUG=true

# FR-15 (app-hub only): how App Hub loads its nested remote — static (vite `remotes`) | runtime (registerRemotes + loadRemote)
VITE_CAD_LOADER=static
